# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ───────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Testing ────────────────────────────────────────────────
/coverage

# ── Next.js ────────────────────────────────────────────────
/.next/
/out/

# ── Production build ───────────────────────────────────────
/build

# ── Environment files (NEVER commit secrets) ───────────────
.env
.env.*
!.env.example

# ── Firebase service account keys (NEVER commit) ──────────
*-firebase-adminsdk-*.json
serviceAccountKey*.json

# ── Debug logs ─────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS generated files ────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# ── IDE / Editor ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Vercel ────────────────────────────────────────────────
.vercel

# ── Large binary assets (keep repo lean) ──────────────────
*.pdf
*.docx
*.doc
*.xlsx
*.pptx
pdf_pages_preview/
pdf_headers_summary.png

# ── Python dev scripts (not part of the app) ──────────────
*.py
*.pyc
__pycache__/

# ── Dev data / scratch files ──────────────────────────────
150_questions.txt
static_data.txt
fbq_grade10_generated.json
fbq_grade10_ts.txt

# ── AI / Gemini tooling ──────────────────────────────────
.gemini/
CLAUDE.md
